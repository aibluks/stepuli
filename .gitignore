# Never include local configuration, credentials, captures or runtime assets.
.env
.env.*
*.log
*.jpg
*.jpeg
*.png
*.webp
node_modules/
runtime/
public-client-config.json
deployment-evidence.json

# Model weights are distributed separately; do not commit binaries.
*.gguf

# Manual model mirror: reviewed text only.
!/.github/workflows/mirror-model.yml
!/scripts/
!/scripts/mirror_model.py
!/scripts/test_mirror_model.py
